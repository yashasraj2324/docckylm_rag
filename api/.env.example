# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=docckylm

# Redis
REDIS_URL=redis://localhost:6379/0

# Single-user demo identity
# Generate one with: python -c "import uuid; print(uuid.uuid4())"
DEMO_USER_ID=replace-with-a-fixed-uuid

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=notebook_lm
QDRANT_TIMEOUT=120
QDRANT_BATCH_SIZE=8
# Optional DNS workaround for hosted Qdrant
QDRANT_RESOLVED_IP=

# Azure OpenAI (chat and text embeddings)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-api-key
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# NVIDIA API (reranking and vision captions)
NVIDIA_API_KEY=replace-with-your-nvidia-api-key
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_VISION_TIMEOUT=30
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2

# OpenRouter visual embeddings
# Visual indexing/retrieval is optional when this key is not configured.
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_EMBEDDING_TIMEOUT=10
ENABLE_VISUAL_RETRIEVAL=true

# Optional web search and podcast integrations
FIRECRAWL_API_KEY=
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_TIMEOUT=60

# Pydantic Logfire Observability (optional token to export traces to logfire.pydantic.dev)
# If left blank, Logfire runs safely in local console mode.
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=ai-notebooks-api

# Frontend-to-backend proxy
API_BACKEND_URL=http://127.0.0.1:8001
# Next.js upload body limit (set in the root .env.local)
NEXT_CLIENT_MAX_BODY_SIZE=50mb
